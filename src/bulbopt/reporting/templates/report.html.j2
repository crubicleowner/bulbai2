<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>BulbOpt Desktop Report</title>
  </head>
  <body>
    <h1>BulbOpt Desktop Report</h1>
    <p>Case: {{ case_name }}</p>
    <p>Status: {{ status }}</p>
    <p>Best candidate: {{ best_candidate_id }}</p>
    <p>Runtime budget: {{ runtime_budget_hours }} h</p>
    <p>Candidate count: {{ candidate_count }}</p>
    <p>Processed candidates: {{ processed_candidates }}</p>
    {% if repair_summary %}
    <h2>Geometry repair</h2>
    <p>Repair status: {{ repair_summary.repair_status }}</p>
    <p>Watertight before: {{ repair_summary.watertight_before }}</p>
    <p>Watertight after: {{ repair_summary.watertight }}</p>
    <p>Vertices (before → after): {{ repair_summary.vertices_count_before }} → {{ repair_summary.vertices_count }}</p>
    <p>Faces (before → after): {{ repair_summary.faces_count_before }} → {{ repair_summary.faces_count }}</p>
    {% endif %}
    {% if objective_weights %}
    <h2>Objective weights</h2>
    <p>Resistance weight: {{ objective_weights.resistance_weight }}</p>
    <p>Axial gain weight: {{ objective_weights.axial_gain_weight }}</p>
    <p>Draft reduction weight: {{ objective_weights.draft_reduction_weight }}</p>
    <p>Beam growth weight: {{ objective_weights.beam_growth_weight }}</p>
    <p>Calm-water condition weight: {{ objective_weights.calm_water_condition_weight }}</p>
    <p>Wave condition weight: {{ objective_weights.wave_condition_weight }}</p>
    {% endif %}
    {% if acceptability_thresholds %}
    <h2>Acceptability thresholds</h2>
    <p>Max volume delta: {{ acceptability_thresholds.max_volume_delta_pct }}</p>
    <p>Max draft delta: {{ acceptability_thresholds.max_draft_delta_m }}</p>
    <p>Max speed balance: {{ acceptability_thresholds.max_speed_balance_ratio }}</p>
    <p>Warn wave penalty: {{ acceptability_thresholds.max_wave_penalty }}</p>
    <p>Reject volume delta: {{ acceptability_thresholds.reject_volume_delta_pct }}</p>
    <p>Reject draft delta: {{ acceptability_thresholds.reject_draft_delta_m }}</p>
    <p>Reject speed balance: {{ acceptability_thresholds.reject_speed_balance_ratio }}</p>
    <p>Reject wave penalty: {{ acceptability_thresholds.reject_wave_penalty }}</p>
    {% endif %}
    {% if operational_profile_summary %}
    <h2>Operational profile</h2>
    <p>Profile source: {{ operational_profile_summary.profile_source }}</p>
    <p>Dominant speed: {{ operational_profile_summary.dominant_speed_knots }}</p>
    <p>Speeds: {{ operational_profile_summary.speed_knots|join(", ") }}</p>
    <p>Weights: {{ operational_profile_summary.operational_profile_weights|join(", ") }}</p>
    {% endif %}
    <p>OpenFOAM available: {{ openfoam_available }}</p>
    <p>High fidelity used: {{ high_fidelity_used }}</p>
    {% if optimization_summary %}
    <h2>Optimization summary</h2>
    <p>Best candidate: {{ optimization_summary.best_candidate_id }}</p>
    <p>Ranked candidates: {{ optimization_summary.ranked_count }}</p>
    <p>Acceptable candidates: {{ optimization_summary.acceptable_count }}</p>
    <p>Unacceptable candidates: {{ optimization_summary.unacceptable_count }}</p>
    <p>OK candidates: {{ optimization_summary.ok_count }}</p>
    <p>Warn candidates: {{ optimization_summary.warn_count }}</p>
    <p>Reject candidates: {{ optimization_summary.reject_count }}</p>
    <p>Best mid score: {{ optimization_summary.best_mid_score }}</p>
    <p>Worst mid score: {{ optimization_summary.worst_mid_score }}</p>
    <p>Mid-score spread: {{ optimization_summary.mid_score_spread }}</p>
    {% endif %}
    {% if best_candidate %}
    <h2>Best Candidate Metrics</h2>
    <p>Fast score: {{ best_candidate.fast_score }}</p>
    <p>Mid score: {{ best_candidate.mid_score }}</p>
    <p>Resistance proxy: {{ best_candidate.score_components.resistance_proxy }}</p>
    <p>Frontal area proxy: {{ best_candidate.score_components.frontal_area_proxy_m2 }}</p>
    <p>Slenderness ratio: {{ best_candidate.geometry_metrics.slenderness_ratio }}</p>
    <p>Surface area: {{ best_candidate.geometry_metrics.surface_area_m2 }}</p>
    <p>Axial extent: {{ best_candidate.geometry_metrics.axial_extent_m }}</p>
    <p>Beam extent: {{ best_candidate.geometry_metrics.beam_extent_m }}</p>
    <p>Draft extent: {{ best_candidate.geometry_metrics.draft_extent_m }}</p>
    {% if best_candidate.hydrostatics_metrics %}
    <h2>Hydrostatics-lite</h2>
    <p>Volume proxy: {{ best_candidate.hydrostatics_metrics.volume_proxy_m3 }}</p>
    <p>Volume delta: {{ best_candidate.hydrostatics_metrics.volume_delta_pct }}%</p>
    <p>Draft delta: {{ best_candidate.hydrostatics_metrics.draft_delta_m }}</p>
    <p>Hydrostatic penalty: {{ best_candidate.score_components.hydrostatic_penalty }}</p>
    <p>Constraint status: {{ best_candidate.hydrostatics_metrics.constraint_status }}</p>
    {% endif %}
    {% if calm_water_summary %}
    <h2>Calm-water surrogate</h2>
    <p>Surrogate model: {{ calm_water_summary.surrogate_model }}</p>
    <p>Mean Froude number: {{ calm_water_summary.mean_froude_number }}</p>
    <p>Speed count: {{ calm_water_summary.speed_count }}</p>
    <p>Mean resistance proxy: {{ calm_water_summary.mean_resistance_proxy }}</p>
    <p>Mean power proxy: {{ calm_water_summary.mean_power_proxy_kw }}</p>
    <p>Mean Effective power proxy: {{ calm_water_summary.mean_effective_power_proxy_kw }}</p>
    <p>Mean fuel proxy: {{ calm_water_summary.mean_fuel_proxy_kgph }}</p>
    <p>Aggregate resistance proxy: {{ calm_water_summary.aggregate_resistance_proxy }}</p>
    <p>Aggregate power proxy: {{ calm_water_summary.aggregate_power_proxy_kw }}</p>
    <p>Aggregate Effective power proxy: {{ calm_water_summary.aggregate_effective_power_proxy_kw }}</p>
    <p>Aggregate fuel proxy: {{ calm_water_summary.aggregate_fuel_proxy_kgph }}</p>
    <p>Reference aggregate resistance proxy: {{ calm_water_summary.reference_aggregate_resistance_proxy }}</p>
    <p>Reference aggregate power proxy: {{ calm_water_summary.reference_aggregate_power_proxy_kw }}</p>
    <p>Reference aggregate Effective power proxy: {{ calm_water_summary.reference_aggregate_effective_power_proxy_kw }}</p>
    <p>Reference aggregate fuel proxy: {{ calm_water_summary.reference_aggregate_fuel_proxy_kgph }}</p>
    <p>Resistance improvement: {{ calm_water_summary.resistance_improvement_pct }}%</p>
    <p>Power improvement: {{ calm_water_summary.power_improvement_pct }}%</p>
    <p>Effective power improvement: {{ calm_water_summary.effective_power_improvement_pct }}%</p>
    <p>Fuel improvement: {{ calm_water_summary.fuel_improvement_pct }}%</p>
    <p>Dominant speed: {{ calm_water_summary.dominant_speed_knots }}</p>
    <p>Calm-water penalty: {{ calm_water_summary.calm_water_penalty }}</p>
    {% endif %}
    {% if wave_response_summary %}
    <h2>Wave-response surrogate</h2>
    <p>Wave height: {{ wave_response_summary.wave_height_m }}</p>
    <p>Wave period: {{ wave_response_summary.wave_period_s }}</p>
    <p>Scenario source: {{ wave_response_summary.scenario_source }}</p>
    <p>Scenario count: {{ wave_response_summary.scenario_count }}</p>
    <p>Dominant scenario: {{ wave_response_summary.dominant_scenario_label }}</p>
    <p>Added resistance proxy: {{ wave_response_summary.added_resistance_proxy }}</p>
    <p>Added power proxy: {{ wave_response_summary.added_power_proxy_kw }}</p>
    <p>Wave penalty: {{ wave_response_summary.wave_penalty }}</p>
    <p>Condition status: {{ wave_response_summary.condition_status }}</p>
    {% if wave_response_summary.scenario_rows %}
    <h3>Wave scenarios</h3>
    <ul>
      {% for row in wave_response_summary.scenario_rows %}
      <li>{{ row }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% endif %}
    {% if multi_condition_summary %}
    <h2>Multi-condition objective</h2>
    <p>Combined penalty: {{ multi_condition_summary.combined_penalty }}</p>
    <p>Combined objective score: {{ multi_condition_summary.combined_objective_score }}</p>
    <p>Dominant condition: {{ multi_condition_summary.dominant_condition }}</p>
    <p>Calm-water weight: {{ multi_condition_summary.calm_water_weight }}</p>
    <p>Wave-response weight: {{ multi_condition_summary.wave_response_weight }}</p>
    {% endif %}
    {% if selection_priority_summary %}
    <h2>Selection priority</h2>
    <p>Calibration model: {{ selection_priority_summary.calibration_model }}</p>
    <p>Selection priority score: {{ selection_priority_summary.selection_priority_score }}</p>
    <p>CFD focus band: {{ selection_priority_summary.cfd_focus_band }}</p>
    {% endif %}
    {% if baseline_summary %}
    <h2>Baseline comparison</h2>
    <p>Reference vs candidate: {{ baseline_summary.reference_vs_candidate }}</p>
    <p>Reference aggregate power proxy: {{ baseline_summary.reference_aggregate_power_proxy_kw }}</p>
    <p>Reference aggregate fuel proxy: {{ baseline_summary.reference_aggregate_fuel_proxy_kgph }}</p>
    <p>Resistance improvement: {{ baseline_summary.resistance_improvement_pct }}%</p>
    <p>Power improvement: {{ baseline_summary.power_improvement_pct }}%</p>
    <p>Fuel improvement: {{ baseline_summary.fuel_improvement_pct }}%</p>
    {% endif %}
    {% if high_fidelity_boundary %}
    <h2>High-fidelity boundary</h2>
    <p>Adapter: {{ high_fidelity_boundary.adapter }}</p>
    <p>Available: {{ high_fidelity_boundary.available }}</p>
    <p>Used: {{ high_fidelity_boundary.used }}</p>
    <p>Mode: {{ high_fidelity_boundary.mode }}</p>
    <p>Case built: {{ high_fidelity_boundary.case_built }}</p>
    <p>Mesh templates: {{ high_fidelity_boundary.mesh_templates|join(", ") }}</p>
    <p>Runner status: {{ high_fidelity_boundary.runner_status }}</p>
    <p>Runner reason: {{ high_fidelity_boundary.runner_reason }}</p>
    <p>OpenFOAM case directory: {{ high_fidelity_boundary.case_directory }}</p>
    {% endif %}
    {% if best_candidate.acceptability %}
    <h2>Acceptability summary</h2>
    <p>Acceptability level: {{ best_candidate.acceptability.level }}</p>
    <p>Acceptable: {{ best_candidate.acceptability.is_acceptable }}</p>
    <p>Hydrostatics status: {{ best_candidate.acceptability.hydrostatics_status }}</p>
    <p>Operational profile status: {{ best_candidate.acceptability.operational_profile_status }}</p>
    <p>Wave response status: {{ best_candidate.acceptability.wave_response_status }}</p>
    <p>Reasons: {{ best_candidate.acceptability.reasons|join(", ") if best_candidate.acceptability.reasons else "none" }}</p>
    {% endif %}
    {% endif %}
    {% if optimization_trace %}
    <h2>Optimization trace</h2>
    <p>{{ optimization_trace.summary }}</p>
    {% if optimization_trace.rows %}
    <ul>
      {% for row in optimization_trace.rows %}
      <li>{{ row }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% endif %}
    {% if ranked_candidates %}
    <h2>Candidate Comparison</h2>
    <ul>
      {% for candidate in ranked_candidates %}
      <li>
        {{ candidate.candidate_id }} |
        level={{ candidate.acceptability.level }} |
        fast={{ candidate.fast_score }} |
          mid={{ candidate.mid_score }} |
          resistance={{ candidate.score_components.resistance_proxy }} |
          hydro={{ candidate.score_components.hydrostatic_penalty }} |
          calm={{ candidate.score_components.calm_water_penalty }} |
          wave={{ candidate.score_components.wave_penalty }} |
          slenderness={{ candidate.geometry_metrics.slenderness_ratio }} |
          reasons={{ candidate.acceptability.reasons|join(", ") if candidate.acceptability.reasons else "none" }}
        </li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if ranked_candidates %}
    {% set rejected = ranked_candidates | selectattr('acceptability.level', 'equalto', 'reject') | list %}
    {% if rejected %}
    <h2>Rejected candidates</h2>
    <ul>
      {% for candidate in rejected %}
        <li>{{ candidate.candidate_id }} | resistance={{ candidate.score_components.resistance_proxy }} | hydro={{ candidate.score_components.hydrostatic_penalty }} | calm={{ candidate.score_components.calm_water_penalty }} | wave={{ candidate.score_components.wave_penalty }} | reasons={{ candidate.acceptability.reasons|join(", ") if candidate.acceptability.reasons else "none" }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% endif %}
  </body>
</html>
