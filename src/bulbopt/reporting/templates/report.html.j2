<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>BulbOpt Desktop Report</title>
  </head>
  <body>
    <h1>BulbOpt Desktop Report</h1>
    <p>Case: {{ case_name }}</p>
    <p>Status: {{ status }}</p>
    <p>Best candidate: {{ best_candidate_id }}</p>
    <p>Runtime budget: {{ runtime_budget_hours }} h</p>
    <p>Candidate count: {{ candidate_count }}</p>
    <p>Processed candidates: {{ processed_candidates }}</p>
    <p>OpenFOAM available: {{ openfoam_available }}</p>
    <p>High fidelity used: {{ high_fidelity_used }}</p>
    {% if optimization_summary %}
    <h2>Optimization summary</h2>
    <p>Best candidate: {{ optimization_summary.best_candidate_id }}</p>
    <p>Ranked candidates: {{ optimization_summary.ranked_count }}</p>
    <p>Best mid score: {{ optimization_summary.best_mid_score }}</p>
    <p>Worst mid score: {{ optimization_summary.worst_mid_score }}</p>
    <p>Mid-score spread: {{ optimization_summary.mid_score_spread }}</p>
    {% endif %}
    {% if best_candidate %}
    <h2>Best Candidate Metrics</h2>
    <p>Fast score: {{ best_candidate.fast_score }}</p>
    <p>Mid score: {{ best_candidate.mid_score }}</p>
    <p>Resistance proxy: {{ best_candidate.score_components.resistance_proxy }}</p>
    <p>Frontal area proxy: {{ best_candidate.score_components.frontal_area_proxy_m2 }}</p>
    <p>Slenderness ratio: {{ best_candidate.geometry_metrics.slenderness_ratio }}</p>
    <p>Surface area: {{ best_candidate.geometry_metrics.surface_area_m2 }}</p>
    <p>Axial extent: {{ best_candidate.geometry_metrics.axial_extent_m }}</p>
    <p>Beam extent: {{ best_candidate.geometry_metrics.beam_extent_m }}</p>
    <p>Draft extent: {{ best_candidate.geometry_metrics.draft_extent_m }}</p>
    {% endif %}
    {% if ranked_candidates %}
    <h2>Candidate Comparison</h2>
    <ul>
      {% for candidate in ranked_candidates %}
      <li>
        {{ candidate.candidate_id }} |
        fast={{ candidate.fast_score }} |
        mid={{ candidate.mid_score }} |
        resistance={{ candidate.score_components.resistance_proxy }} |
        slenderness={{ candidate.geometry_metrics.slenderness_ratio }}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </body>
</html>
